{
  "name": "keyword-pro",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Local-first keyword research with guided reports, charts, saved sessions, and exports.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgriciDaniel/keywordpro.git"
  },
  "bugs": {
    "url": "https://github.com/AgriciDaniel/keywordpro/issues"
  },
  "homepage": "https://github.com/AgriciDaniel/keywordpro#readme",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "next dev --turbo --hostname 127.0.0.1 --port 3002",
    "build": "next build",
    "start": "pnpm --ignore-workspace validate:runtime && next start --hostname 127.0.0.1 --port 3002",
    "seed": "tsx --tsconfig tsconfig.json scripts/seed-local-user.ts",
    "db:migrate": "tsx --tsconfig tsconfig.json scripts/migrate-database.ts",
    "db:studio": "drizzle-kit studio",
    "legacy:inventory": "tsx --tsconfig tsconfig.json scripts/inventory-legacy-data.ts",
    "legacy:export": "tsx --tsconfig tsconfig.json scripts/export-legacy-data.ts",
    "public:candidate": "tsx --tsconfig tsconfig.json scripts/build-public-candidate.ts",
    "generate:locations": "tsx --tsconfig tsconfig.json scripts/generate-locations-languages.ts",
    "generate:targeting": "tsx --tsconfig tsconfig.json scripts/generate-endpoint-targeting.ts",
    "generate:fixtures": "tsx --tsconfig tsconfig.json scripts/generate-synthetic-fixtures.ts",
    "demo:seed": "tsx --tsconfig tsconfig.json scripts/seed-synthetic-demo.ts",
    "generate:keyword-endpoints": "node scripts/prune-keyword-endpoints.mjs && tsx --tsconfig tsconfig.json scripts/generate-endpoint-targeting.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "validate:runtime": "tsx --tsconfig tsconfig.json scripts/validate-runtime-environment.ts",
    "ci": "pnpm --ignore-workspace lint && pnpm --ignore-workspace typecheck && pnpm --ignore-workspace verify && pnpm --ignore-workspace build",
    "verify:projectors": "tsx --tsconfig tsconfig.json scripts/verify-projectors.ts",
    "verify:fixtures": "tsx --tsconfig tsconfig.json scripts/verify-fixtures.ts",
    "verify:fixture-provenance": "tsx --tsconfig tsconfig.json scripts/generate-synthetic-fixtures.ts --check",
    "verify:synthetic-demo": "tsx --tsconfig tsconfig.json scripts/verify-synthetic-demo.ts",
    "verify:screenshot-provenance": "tsx --tsconfig tsconfig.json scripts/verify-screenshot-provenance.ts",
    "verify:repository-safety": "tsx --tsconfig tsconfig.json scripts/verify-repository-safety.ts",
    "verify:public-candidate": "tsx --tsconfig tsconfig.json scripts/verify-public-candidate.ts",
    "verify:views": "tsx --tsconfig tsconfig.json scripts/verify-result-views.tsx",
    "verify:analytics": "tsx --tsconfig tsconfig.json scripts/verify-analytics.ts",
    "verify:bundle": "tsx --tsconfig tsconfig.json scripts/verify-bundle.ts",
    "verify:database": "tsx --tsconfig tsconfig.json scripts/verify-database-migration.ts",
    "verify:legacy-data": "tsx --tsconfig tsconfig.json scripts/verify-legacy-data-tools.ts",
    "verify:encryption": "cross-env NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/verify-encryption.ts",
    "verify:keyword-pro": "tsx --tsconfig tsconfig.json scripts/verify-keyword-pro.ts",
    "verify": "tsc --noEmit && tsx --tsconfig tsconfig.json scripts/verify-keyword-pro.ts && tsx --tsconfig tsconfig.json scripts/verify-projectors.ts && tsx --tsconfig tsconfig.json scripts/generate-synthetic-fixtures.ts --check && tsx --tsconfig tsconfig.json scripts/verify-fixtures.ts && tsx --tsconfig tsconfig.json scripts/verify-synthetic-demo.ts && tsx --tsconfig tsconfig.json scripts/verify-screenshot-provenance.ts && tsx --tsconfig tsconfig.json scripts/verify-repository-safety.ts && tsx --tsconfig tsconfig.json scripts/verify-result-views.tsx && tsx --tsconfig tsconfig.json scripts/verify-analytics.ts && tsx --tsconfig tsconfig.json scripts/verify-bundle.ts && tsx --tsconfig tsconfig.json scripts/verify-targeting.ts && cross-env NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/verify-runtime-env.ts && cross-env NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/verify-encryption.ts && tsx --tsconfig tsconfig.json scripts/verify-database-migration.ts && tsx --tsconfig tsconfig.json scripts/verify-legacy-data-tools.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "^16.3.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.10.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.3",
    "nanoid": "^5.1.6",
    "next": "16.3.3",
    "next-intl": "^4.8.3",
    "next-safe-action": "^8.1.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "postgres": "^3.4.8",
    "rate-limiter-flexible": "^9.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.15.0",
      "lodash": "4.17.23",
      "lodash-es": "4.17.23",
      "mdast-util-to-hast": "13.2.1",
      "markdown-it": "14.1.1",
      "fast-xml-parser": "5.3.8",
      "prismjs": "1.30.0",
      "refractor>prismjs": "1.30.0",
      "esbuild": "0.28.1",
      "next>postcss": "8.5.26",
      "next>sharp": "0.35.0"
    }
  }
}
